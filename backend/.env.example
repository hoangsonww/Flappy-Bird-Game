# ─────────────────────────────────────────────────────────────────────────────
# Flappy Bird backend configuration
#
# Copy to backend/.env (or the repository root) and edit. Every value below is
# a default, so an empty file also works for local development.
#
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Absolute URL this server is reachable at; used in docs links and the banner.
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# ── Storage ──────────────────────────────────────────────────────────────────
# memory   → zero setup, data lost on restart (great for a first run and tests)
# postgres → durable; requires DATABASE_URL (docker compose provides one)
DB_DRIVER=memory
DATABASE_URL=postgres://flappy:flappy@localhost:5432/flappybird
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Apply pending migrations automatically at boot (postgres driver only).
DATABASE_AUTO_MIGRATE=true

# ── Authentication ───────────────────────────────────────────────────────────
# Leave blank in development and ephemeral secrets are generated at boot
# (tokens then stop working after a restart). REQUIRED in production.
#   openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=flappy-bird-backend
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=11

# ── HTTP hardening ───────────────────────────────────────────────────────────
# Comma-separated origins, or * for any.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=20
SUBMIT_RATE_LIMIT_MAX=60

# ── Moderation & fair play ───────────────────────────────────────────────────
# Static token accepted as X-Admin-Token on /v1/admin routes. Blank disables it.
ADMIN_TOKEN=
# Shared secret the game uses to HMAC-sign runs. Blank disables signature checks.
RUN_SIGNING_SECRET=
# Reject every unsigned run. Only enable when the game ships the same secret.
REQUIRE_SIGNED_RUNS=false
MAX_SCORE=100000
MAX_PIPES_PER_SECOND=1.6

# ── Feature switches ─────────────────────────────────────────────────────────
ENABLE_DOCS=true
ENABLE_METRICS=true
ENABLE_SSE=true
ENABLE_GUEST_ACCOUNTS=true
LEADERBOARD_PAGE_MAX=100
